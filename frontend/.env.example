# VARUNA Frontend Configuration

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000
# In Vercel, set this to the deployed Render service URL (no trailing slash).
# VITE_API_BASE_URL=https://your-render-service.onrender.com

# Set to true only to use synthetic demo output instead of the FastAPI models
VITE_DEMO_MODE=false

# Optional Cesium Ion Token (free from https://ion.cesium.com/tokens)
# Without token, the viewer falls back to keyless open-imagery with procedural terrain
VITE_CESIUM_ION_TOKEN=

# Optional Weather / Radar endpoints
VITE_WEATHER_PROVIDER=
VITE_WEATHER_API_URL=
VITE_WEATHER_API_KEY=
VITE_RAIN_RADAR_URL=
VITE_RAIN_RADAR_TIMES=
